#!/bin/sh /etc/rc.common
# MyBox 面板（OpenWrt / iStoreOS，procd 管理）
#
# Node 运行时随包放在 $ROOT/node —— OpenWrt 自带的 node 太旧，且大多数固件
# 根本没装。这里用 unofficial-builds 的 musl 版官方构建。

USE_PROCD=1
START=98
STOP=11

ROOT=/opt/mybox
NODE="$ROOT/node/bin/node"
ENTRY="$ROOT/server/index.mjs"
DATA="$ROOT/data"

start_service() {
	if [ ! -x "$NODE" ]; then
		logger -t mybox "Node 运行时不存在：$NODE"
		return 0
	fi
	if [ ! -f "$ENTRY" ]; then
		logger -t mybox "面板入口不存在：$ENTRY"
		return 0
	fi

	mkdir -p "$DATA"

	procd_open_instance
	procd_set_param command "$NODE" "$ENTRY"
	procd_set_param env MYBOX_ROOT="$ROOT" NODE_ENV=production
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

stop_service() {
	killall -9 node 2>/dev/null || true
}
